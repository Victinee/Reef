# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from the github gitignore repository
# https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to only check in ONLY source files and not compiled assets
# /[Aa]ssets/[Ss]treamingAssets/

# Uncomment this line if you wish to ignore all imported assets
# /[Aa]ssets/[Pp]lugins/Android/

# Unity3D generated meta files
/[Kk]eep[Mm]eta
/[Kk]eep[Mm]eta.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary cache
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta

# Visual Studio / Rider / VSCode cache directory and files 
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Visual Studio Code cache
.vscode/

# Rider
.idea/
*.sln.iml

# MacOS
.DS_Store
*.swp
*~

# Tutorial templates
Assets/LightingOptimizationTutorial/
Assets/LightingOptimizationTutorial.meta
